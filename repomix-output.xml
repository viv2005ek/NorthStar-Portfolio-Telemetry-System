import { useState } from 'react';
import { Login } from './components/Login';
import { Dashboard } from './components/Dashboard';
import { getCurrentUser, getAuthToken, User } from './services/api';

export function App() {
  const [user, setUser] = useState<User | null>(() => {
    const token = getAuthToken();
    const currentUser = getCurrentUser();
    return token && currentUser ? currentUser : null;
  });

  const handleLoginSuccess = (loggedInUser: User) => {
    setUser(loggedInUser);
  };

  const handleLogout = () => {
    setUser(null);
  };

  if (!user) {
    return <Login onLoginSuccess={handleLoginSuccess} />;
  }

  return <Dashboard user={user} onLogout={handleLogout} />;
}

export default App;
</file>

<file path="frontend/src/components/Dashboard.tsx">
import React, { useEffect, useState, useCallback } from 'react';
import { fetchDashboardApi, DashboardResponse, clearAuth, User } from '../services/api';
import { UploadCSV } from './UploadCSV';
import { PortfolioChart } from './PortfolioChart';
import {
  LogOut,
  RefreshCw,
  FolderPlus,
  LayoutDashboard,
  Table as TableIcon,
  BarChart3,
  Sliders,
  ArrowUpRight,
  ArrowDownRight
} from 'lucide-react';

interface DashboardProps {
  user: User;
  onLogout: () => void;
}

export const Dashboard: React.FC<DashboardProps> = ({ user, onLogout }) => {
  const [data, setData] = useState<DashboardResponse | null>(null);
  const [loading, setLoading] = useState<boolean>(true);
  const [error, setError] = useState<string | null>(null);
  const [activeTab, setActiveTab] = useState<'overview' | 'holdings' | 'analytics'>('overview');
  const [tickerSearch, setTickerSearch] = useState<string>('');

  const loadDashboard = useCallback(async () => {
    setLoading(true);
    setError(null);
    try {
      const res = await fetchDashboardApi();
      setData(res);
    } catch (err: unknown) {
      const errorObj = err as { message?: string; status?: number };
      if (errorObj.status === 401) {
        clearAuth();
        onLogout();
        return;
      }
      setError(errorObj.message || 'Failed to fetch portfolio metrics');
    } finally {
      setLoading(false);
    }
  }, [onLogout]);

  useEffect(() => {
    loadDashboard();
  }, [loadDashboard]);

  const formatCurrency = (val: number) =>
    new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(val);

  const formatPercent = (val: number) => {
    const pct = val * 100;
    const sign = pct > 0 ? '+' : '';
    return `${sign}${pct.toFixed(2)}%`;
  };

  const formatDateDisplay = (dateStr: string | null) => {
    if (!dateStr) return 'N/A';
    const parsed = new Date(dateStr);
    if (isNaN(parsed.getTime())) return dateStr;
    return parsed.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
  };

  return (
    <div className="min-h-screen bg-[#0b0d10] text-slate-100 flex selection:bg-amber-500/30">
      {/* 1. Slim Understated Sidebar */}
      <aside className="w-60 bg-[#12161f] border-r border-[#212836] flex flex-col justify-between shrink-0 hidden md:flex">
        <div className="p-5 space-y-6">
          {/* Brand Header */}
          <div className="flex items-center gap-2.5">
            <div className="w-7 h-7 rounded bg-[#181e2b] border border-[#212836] text-amber-500 flex items-center justify-center font-mono font-bold text-sm">
              ✦
            </div>
            <div>
              <h1 className="text-sm font-bold tracking-widest font-mono text-slate-100 uppercase leading-none">
                NORTHSTAR
              </h1>
              <span className="text-[10px] font-mono text-slate-500 tracking-wider">
                Portfolio Intelligence
              </span>
            </div>
          </div>

          {/* Navigation Links */}
          <nav className="space-y-1 font-mono text-xs">
            <button
              onClick={() => setActiveTab('overview')}
              className={`w-full flex items-center gap-2.5 px-3 py-2 rounded-md transition-colors cursor-pointer ${
                activeTab === 'overview'
                  ? 'bg-amber-500/10 text-amber-400 border border-amber-500/20 font-semibold'
                  : 'text-slate-400 hover:text-slate-200 hover:bg-[#181e2b]'
              }`}
            >
              <LayoutDashboard className="w-3.5 h-3.5" />
              Overview
            </button>
            <button
              onClick={() => setActiveTab('holdings')}
              className={`w-full flex items-center gap-2.5 px-3 py-2 rounded-md transition-colors cursor-pointer ${
                activeTab === 'holdings'
                  ? 'bg-amber-500/10 text-amber-400 border border-amber-500/20 font-semibold'
                  : 'text-slate-400 hover:text-slate-200 hover:bg-[#181e2b]'
              }`}
            >
              <TableIcon className="w-3.5 h-3.5" />
              Holdings
            </button>
            <button
              onClick={() => setActiveTab('analytics')}
              className={`w-full flex items-center gap-2.5 px-3 py-2 rounded-md transition-colors cursor-pointer ${
                activeTab === 'analytics'
                  ? 'bg-amber-500/10 text-amber-400 border border-amber-500/20 font-semibold'
                  : 'text-slate-400 hover:text-slate-200 hover:bg-[#181e2b]'
              }`}
            >
              <BarChart3 className="w-3.5 h-3.5" />
              Analytics
            </button>
          </nav>
        </div>

        {/* Sidebar Footer */}
        <div className="p-4 border-t border-[#212836] space-y-3 font-mono text-xs">
          <div className="px-2">
            <div className="text-[11px] font-semibold text-slate-200 truncate">{user.email}</div>
            <div className="text-[10px] text-slate-500 truncate">{data?.tenantName || user.tenantName}</div>
          </div>

          <div className="space-y-1">
            <button
              onClick={() => alert('Settings configuration view')}
              className="w-full flex items-center gap-2 px-2 py-1.5 text-slate-400 hover:text-slate-200 text-[11px] rounded transition-colors cursor-pointer"
            >
              <Sliders className="w-3 h-3" /> System Settings
            </button>

            <button
              onClick={() => {
                clearAuth();
                onLogout();
              }}
              className="w-full flex items-center gap-2 px-2 py-1.5 text-rose-400/90 hover:text-rose-300 text-[11px] rounded hover:bg-rose-950/20 transition-colors cursor-pointer"
            >
              <LogOut className="w-3 h-3" /> Sign Out
            </button>
          </div>
        </div>
      </aside>

      {/* 2. Main Content Area */}
      <div className="flex-1 flex flex-col min-w-0">
        {/* Quiet Functional Top Bar */}
        <header className="h-14 border-b border-[#212836] bg-[#12161f] px-6 flex items-center justify-between shrink-0">
          <div className="flex items-center gap-3 font-mono text-xs">
            <span className="text-slate-500">Northstar</span>
            <span className="text-slate-700">/</span>
            <span className="font-semibold text-slate-200">{data?.tenantName || user.tenantName}</span>
            <span className="px-1.5 py-0.5 rounded bg-emerald-950/60 border border-emerald-800/40 text-emerald-400 text-[10px] flex items-center gap-1">
              <span className="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse" /> Active Tenant
            </span>
          </div>

          <div className="flex items-center gap-3 font-mono text-xs">
            <button
              onClick={loadDashboard}
              disabled={loading}
              className="p-1.5 rounded bg-[#181e2b] hover:bg-[#212836] border border-[#212836] text-slate-400 hover:text-slate-200 transition-colors cursor-pointer disabled:opacity-50"
              title="Refresh Portfolio Data"
            >
              <RefreshCw className={`w-3.5 h-3.5 ${loading ? 'animate-spin' : ''}`} />
            </button>

            <button
              onClick={() => {
                clearAuth();
                onLogout();
              }}
              className="md:hidden p-1.5 rounded bg-[#181e2b] text-slate-400 hover:text-rose-400 border border-[#212836] transition-colors"
            >
              <LogOut className="w-3.5 h-3.5" />
            </button>
          </div>
        </header>

        {/* Main Dashboard Body */}
        <main className="p-6 md:p-8 space-y-8 flex-1 overflow-y-auto max-w-6xl w-full mx-auto">
          {/* Skeleton Loading State */}
          {loading && !data && (
            <div className="space-y-6">
              <div className="h-32 bg-[#12161f] border border-[#212836] rounded-xl animate-pulse p-6 space-y-4">
                <div className="h-3 w-32 bg-[#212836] rounded" />
                <div className="h-8 w-48 bg-[#212836] rounded" />
              </div>
              <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div className="h-64 bg-[#12161f] border border-[#212836] rounded-xl animate-pulse" />
                <div className="h-64 bg-[#12161f] border border-[#212836] rounded-xl animate-pulse" />
              </div>
            </div>
          )}

          {error && (
            <div className="p-4 rounded-xl bg-rose-950/30 border border-rose-900/40 text-rose-300 text-xs font-mono">
              {error}
            </div>
          )}

          {data && (
            <>
              {/* 3. Hero / Portfolio Summary */}
              <div className="bg-[#12161f] border border-[#212836] rounded-xl p-6 shadow-sm space-y-6">
                <div className="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-[#212836] pb-5">
                  <div className="space-y-1">
                    <span className="text-[10px] font-mono font-bold text-slate-500 uppercase tracking-widest">
                      PORTFOLIO OVERVIEW &bull; {data.tenantName}
                    </span>
                    <div className="flex items-baseline gap-4">
                      <span className="text-3xl md:text-4xl font-extrabold tracking-tight text-slate-100 font-mono tabular-nums">
                        {formatCurrency(data.endMarketValue)}
                      </span>

                      {/* Performance Metric Badge */}
                      <div className={`inline-flex items-center gap-1 px-2.5 py-1 rounded text-xs font-mono font-bold border ${
                        data.periodReturn >= 0
                          ? 'bg-emerald-950/50 border-emerald-800/40 text-emerald-400'
                          : 'bg-rose-950/50 border-rose-800/40 text-rose-400'
                      }`}>
                        {data.periodReturn >= 0 ? (
                          <ArrowUpRight className="w-3.5 h-3.5" />
                        ) : (
                          <ArrowDownRight className="w-3.5 h-3.5" />
                        )}
                        <span>{formatPercent(data.periodReturn)}</span>
                        <span className="text-[10px] text-slate-500 ml-1 font-normal uppercase">Period Return</span>
                      </div>
                    </div>
                  </div>

                  <div className="text-left md:text-right font-mono text-xs text-slate-400 space-y-1">
                    <div>Valuation Period:</div>
                    <div className="font-semibold text-slate-200">
                      {formatDateDisplay(data.startDate)} &mdash; {formatDateDisplay(data.endDate)}
                    </div>
                  </div>
                </div>

                {/* Sub-Metrics: Start & End Value */}
                <div className="grid grid-cols-2 md:grid-cols-4 gap-4 font-mono text-xs">
                  <div className="p-3.5 bg-[#0b0d10] border border-[#212836] rounded-lg">
                    <span className="text-[10px] text-slate-500 uppercase">Start Value</span>
                    <div className="text-base font-bold text-slate-200 mt-1 tabular-nums">
                      {formatCurrency(data.startMarketValue)}
                    </div>
                    <span className="text-[10px] text-slate-600">{formatDateDisplay(data.startDate)}</span>
                  </div>

                  <div className="p-3.5 bg-[#0b0d10] border border-[#212836] rounded-lg">
                    <span className="text-[10px] text-slate-500 uppercase">End Value</span>
                    <div className="text-base font-bold text-slate-200 mt-1 tabular-nums">
                      {formatCurrency(data.endMarketValue)}
                    </div>
                    <span className="text-[10px] text-slate-600">{formatDateDisplay(data.endDate)}</span>
                  </div>

                  <div className="p-3.5 bg-[#0b0d10] border border-[#212836] rounded-lg">
                    <span className="text-[10px] text-slate-500 uppercase">Asset Classes</span>
                    <div className="text-base font-bold text-amber-500 mt-1 tabular-nums">
                      {data.assetClasses.length}
                    </div>
                    <span className="text-[10px] text-slate-600">Active allocations</span>
                  </div>

                  <div className="p-3.5 bg-[#0b0d10] border border-[#212836] rounded-lg">
                    <span className="text-[10px] text-slate-500 uppercase">Status</span>
                    <div className="text-base font-bold text-emerald-400 mt-1">
                      {data.hasData ? 'Verified' : 'Empty'}
                    </div>
                    <span className="text-[10px] text-slate-600">Audit status</span>
                  </div>
                </div>
              </div>

              {/* 4. Empty State UX */}
              {!data.hasData ? (
                <div className="grid grid-cols-1 md:grid-cols-3 gap-6 items-start">
                  <div className="md:col-span-2 bg-[#12161f] border border-[#212836] rounded-xl p-10 text-center space-y-3 font-mono">
                    <div className="w-10 h-10 rounded-lg bg-[#181e2b] border border-[#212836] text-amber-500 mx-auto flex items-center justify-center text-lg">
                      ✦
                    </div>
                    <div>
                      <h3 className="text-sm font-bold text-slate-200 uppercase tracking-wider">
                        NO PORTFOLIO DATA
                      </h3>
                      <p className="text-xs text-slate-400 mt-1 max-w-xs mx-auto">
                        This tenant portfolio doesn't have any holdings datasets uploaded yet. Import a valid CSV to compute analytics.
                      </p>
                    </div>
                  </div>

                  <div className="md:col-span-1">
                    <UploadCSV onUploadSuccess={loadDashboard} />
                  </div>
                </div>
              ) : (
                /* 5. Main Operational Grid */
                <div className="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
                  {/* Left 2 Columns: Table & Asset Allocation */}
                  <div className="lg:col-span-2 space-y-6">
                    {/* Asset Allocation Panel */}
                    <div className="bg-[#12161f] border border-[#212836] rounded-xl p-5 shadow-sm space-y-4 font-mono">
                      <div className="flex items-center justify-between border-b border-[#212836] pb-3">
                        <h3 className="text-xs font-bold text-slate-200 uppercase tracking-wider flex items-center gap-2">
                          <BarChart3 className="w-3.5 h-3.5 text-amber-500" /> Asset Allocation Breakdown
                        </h3>
                        <span className="text-[10px] text-slate-500">As of {formatDateDisplay(data.endDate)}</span>
                      </div>

                      <PortfolioChart data={data.assetClasses} totalMarketValue={data.endMarketValue} />
                    </div>

                    {/* Operational Holdings Table */}
                    <div className="bg-[#12161f] border border-[#212836] rounded-xl p-5 shadow-sm space-y-4 font-mono">
                      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-[#212836] pb-3">
                        <h3 className="text-xs font-bold text-slate-200 uppercase tracking-wider flex items-center gap-2">
                          <TableIcon className="w-3.5 h-3.5 text-amber-500" /> Holdings Summary
                        </h3>

                        <input
                          type="text"
                          value={tickerSearch}
                          onChange={(e) => setTickerSearch(e.target.value)}
                          placeholder="Filter asset class..."
                          className="px-2.5 py-1 bg-[#0b0d10] border border-[#212836] focus:border-amber-500/60 rounded text-[11px] text-slate-200 placeholder-slate-600 focus:outline-none"
                        />
                      </div>

                      <div className="overflow-x-auto">
                        <table className="w-full text-left text-xs">
                          <thead className="bg-[#0b0d10] uppercase font-semibold text-slate-400 text-[10px] border-b border-[#212836] tracking-wider">
                            <tr>
                              <th className="py-2.5 px-3">Asset Class</th>
                              <th className="py-2.5 px-3 text-right">Market Value</th>
                              <th className="py-2.5 px-3 text-right">Allocation</th>
                            </tr>
                          </thead>
                          <tbody className="divide-y divide-[#212836]">
                            {data.assetClasses
                              .filter((item) => item.assetClass.toLowerCase().includes(tickerSearch.toLowerCase()))
                              .map((item, idx) => {
                                const percentage = data.endMarketValue > 0 ? (item.marketValue / data.endMarketValue) * 100 : 0;
                                return (
                                  <tr key={idx} className="hover:bg-[#181e2b] transition-colors">
                                    <td className="py-3 px-3 font-semibold text-slate-100 flex items-center gap-2">
                                      <span
                                        className="w-2 h-2 rounded-xs inline-block"
                                        style={{
                                          backgroundColor:
                                            item.assetClass === 'Equity'
                                              ? '#d97706'
                                              : item.assetClass === 'Bond'
                                              ? '#0ea5e9'
                                              : '#64748b'
                                        }}
                                      />
                                      {item.assetClass}
                                    </td>
                                    <td className="py-3 px-3 text-right font-medium text-slate-200 tabular-nums">
                                      {formatCurrency(item.marketValue)}
                                    </td>
                                    <td className="py-3 px-3 text-right text-slate-400 tabular-nums">
                                      {percentage.toFixed(1)}%
                                    </td>
                                  </tr>
                                );
                              })}
                          </tbody>
                          <tfoot className="bg-[#0b0d10] font-bold border-t border-[#212836] text-slate-200">
                            <tr>
                              <td className="py-3 px-3">Total Portfolio</td>
                              <td className="py-3 px-3 text-right text-amber-500 tabular-nums">
                                {formatCurrency(data.endMarketValue)}
                              </td>
                              <td className="py-3 px-3 text-right text-slate-400 tabular-nums">100.0%</td>
                            </tr>
                          </tfoot>
                        </table>
                      </div>
                    </div>
                  </div>

                  {/* Right Column: Compact CSV Importer Panel */}
                  <div className="lg:col-span-1">
                    <UploadCSV onUploadSuccess={loadDashboard} />
                  </div>
                </div>
              )}
            </>
          )}
        </main>
      </div>
    </div>
  );
};
</file>

<file path="frontend/src/components/Login.tsx">
import React, { useState } from 'react';
import { loginApi, User } from '../services/api';
import { ArrowRight, AlertCircle, Building2 } from 'lucide-react';

interface LoginProps {
  onLoginSuccess: (user: User) => void;
}

export const Login: React.FC<LoginProps> = ({ onLoginSuccess }) => {
  const [email, setEmail] = useState('');
  const [password, setPassword] = useState('');
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!email || !password) {
      setError('Email and password are required');
      return;
    }

    setLoading(true);
    setError(null);

    try {
      const res = await loginApi(email, password);
      onLoginSuccess(res.user);
    } catch (err: unknown) {
      const errorObj = err as { message?: string };
      setError(errorObj.message || 'Authentication failed. Please check credentials.');
    } finally {
      setLoading(false);
    }
  };

  const handleQuickFill = (testEmail: string) => {
    setEmail(testEmail);
    setPassword('Password123!');
    setError(null);
  };

  return (
    <div className="min-h-screen bg-[#0b0d10] text-slate-100 flex flex-col justify-center items-center px-4 relative selection:bg-amber-500/30">
      <div className="w-full max-w-sm space-y-8">
        {/* Brand Identity */}
        <div className="text-center space-y-2">
          <div className="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-[#12161f] border border-[#212836] text-amber-500 mb-1 shadow-sm">
            <span className="text-lg font-mono font-extrabold tracking-tighter">✦</span>
          </div>
          <div className="space-y-0.5">
            <h1 className="text-xl font-bold tracking-widest uppercase text-slate-100 font-mono">
              NORTHSTAR
            </h1>
            <p className="text-xs text-slate-500 uppercase tracking-widest font-mono">
              Portfolio Intelligence
            </p>
          </div>
        </div>

        {/* Login Panel */}
        <div className="bg-[#12161f] border border-[#212836] p-7 rounded-xl shadow-xl space-y-6">
          {error && (
            <div className="p-3.5 rounded-lg bg-rose-950/30 border border-rose-900/40 text-rose-300 text-xs flex items-start gap-2.5">
              <AlertCircle className="w-4 h-4 text-rose-400 shrink-0 mt-0.5" />
              <span>{error}</span>
            </div>
          )}

          <form onSubmit={handleSubmit} className="space-y-4">
            <div className="space-y-1.5">
              <label className="block text-[11px] font-mono font-medium text-slate-400 uppercase tracking-wider">
                Account Email
              </label>
              <input
                type="email"
                required
                value={email}
                onChange={(e) => setEmail(e.target.value)}
                placeholder="tenant_a@example.com"
                className="w-full px-3.5 py-2.5 bg-[#0b0d10] border border-[#212836] focus:border-amber-500/60 rounded-lg text-slate-100 placeholder-slate-600 text-xs font-mono focus:outline-none transition-colors"
              />
            </div>

            <div className="space-y-1.5">
              <label className="block text-[11px] font-mono font-medium text-slate-400 uppercase tracking-wider">
                Password
              </label>
              <input
                type="password"
                required
                value={password}
                onChange={(e) => setPassword(e.target.value)}
                placeholder="••••••••••••"
                className="w-full px-3.5 py-2.5 bg-[#0b0d10] border border-[#212836] focus:border-amber-500/60 rounded-lg text-slate-100 placeholder-slate-600 text-xs font-mono focus:outline-none transition-colors"
              />
            </div>

            <button
              type="submit"
              disabled={loading}
              className="w-full mt-2 py-2.5 px-4 bg-amber-600 hover:bg-amber-500 active:bg-amber-700 text-slate-950 font-bold text-xs rounded-lg shadow-sm flex items-center justify-center gap-2 transition-all disabled:opacity-50 uppercase tracking-wider font-mono cursor-pointer"
            >
              {loading ? (
                <div className="w-4 h-4 border-2 border-slate-950/30 border-t-slate-950 rounded-full animate-spin" />
              ) : (
                <>
                  Authenticate <ArrowRight className="w-3.5 h-3.5" />
                </>
              )}
            </button>
          </form>

          {/* Seeded Credentials Options */}
          <div className="pt-5 border-t border-[#212836] space-y-2.5">
            <div className="text-[10px] font-mono text-slate-500 uppercase tracking-wider flex items-center gap-1.5">
              <Building2 className="w-3 h-3 text-amber-500/80" /> Seeded Access Accounts:
            </div>
            <div className="grid grid-cols-2 gap-2">
              <button
                type="button"
                onClick={() => handleQuickFill('tenant_a@example.com')}
                className="p-2.5 rounded-lg bg-[#0b0d10] hover:bg-[#181e2b] border border-[#212836] text-left transition-colors cursor-pointer group"
              >
                <div className="text-xs font-semibold text-slate-200 group-hover:text-amber-400 font-mono">
                  Tenant 1
                </div>
                <div className="text-[10px] text-slate-500 truncate">Alpha Capital</div>
              </button>
              <button
                type="button"
                onClick={() => handleQuickFill('tenant_b@example.com')}
                className="p-2.5 rounded-lg bg-[#0b0d10] hover:bg-[#181e2b] border border-[#212836] text-left transition-colors cursor-pointer group"
              >
                <div className="text-xs font-semibold text-slate-200 group-hover:text-amber-400 font-mono">
                  Tenant 2
                </div>
                <div className="text-[10px] text-slate-500 truncate">Beacon Advisors</div>
              </button>
            </div>
          </div>
        </div>

        {/* Footer info */}
